# ---- Recaptcha ----
TWO_CAPTCHA_API_KEY="your-api-key-here"

# ---- Proxy (recommended for production) ----
# Use a residential proxy to avoid reCAPTCHA
# Format: http://username:password@proxy-host:port
# SCRAPER_PROXY="http://username:password@123.45.67.89:8888"

# ---- Scraping Options ----
SCRAPER_MAX_RETRIES=3

# ---- Debug ----
DEBUG_DUMP=0